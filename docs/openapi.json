{
  "openapi": "3.1.0",
  "info": {
    "title": "The Last Ticket API",
    "description": "On-sale ticketing: waiting room, holds with hard expiry, no oversell. Errors are RFC 9457 problem+json with a stable `code` and a `correlationId`.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:18080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/admin/events/{eventId}": {
      "put": {
        "tags": [
          "Operations"
        ],
        "summary": "Create an on-sale with its inventory",
        "description": "Idempotent on the id: 201 when created, 200 when it already existed (body ignored).",
        "operationId": "createEvent",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventSpec"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EventView"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Start an anonymous session",
        "description": "Returns a bearer token identifying a new shopper.",
        "operationId": "createSession",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/reservations": {
      "get": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Your reservations, newest first",
        "operationId": "reservations",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageReservation"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Hold tickets",
        "description": "Places a hold with a hard expiry. Requires an admission token from the waiting room. Safe to retry with the same Idempotency-Key: you get the same reservation back, never a second one. 409 SOLD_OUT / ALREADY_HOLDING / LIMIT_EXCEEDED / NOT_ON_SALE; 503 CONTENTION means nothing happened, retry.",
        "operationId": "reserve",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "pattern": "[A-Za-z0-9._-]{8,100}"
            }
          },
          {
            "name": "X-Admission-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/reservations/{id}/confirm": {
      "post": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Complete the purchase",
        "description": "Idempotent. 410 HOLD_EXPIRED once the hold's deadline has passed.",
        "operationId": "confirm",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/events/{eventId}/queue": {
      "get": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Your place in the waiting room",
        "description": "Poll no faster than pollAfterMs. When ADMITTED, carries the admission token.",
        "operationId": "queueStatus",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Join the waiting room",
        "description": "Idempotent: joining again returns the place you already have.",
        "operationId": "join",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/admin/inventory/{inventoryId}/adjustments": {
      "post": {
        "tags": [
          "Operations"
        ],
        "summary": "Release more stock (delta > 0) or correct it down (delta < 0)",
        "description": "Appended to the aggregate's event stream like any other change. Never breaks an outstanding hold: a correction below held + sold is refused with 409 CORRECTION_BELOW_COMMITTED. expectedVersion makes it safe to retry: a repeat fails with 409 VERSION_MISMATCH instead of applying twice.",
        "operationId": "adjust",
        "parameters": [
          {
            "name": "inventoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Adjustment"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/admin/dead-letters/{id}/replay": {
      "post": {
        "tags": [
          "Operations"
        ],
        "summary": "Send a dead letter back to its topic",
        "description": "Safe to repeat: consumers deduplicate on the message id.",
        "operationId": "replay",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DeadLetter"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/admin/attempts/ingest": {
      "post": {
        "tags": [
          "Operations"
        ],
        "summary": "Ingest a batch of purchase attempts (NDJSON, one attempt per line)",
        "description": "Every line is stored verbatim, then validated; bad lines are quarantined with a reason. Re-sending the same batchId is safe: lines that already have an outcome are skipped.",
        "operationId": "ingest",
        "parameters": [
          {
            "name": "batchId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-ndjson": {
              "schema": {
                "type": "string"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/reservations/{id}": {
      "get": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "One of your reservations",
        "operationId": "reservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Give the tickets back",
        "description": "Idempotent. 409 ALREADY_CLOSED if the order was already confirmed.",
        "operationId": "release",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "List on-sales, soonest first",
        "operationId": "events",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageEventView"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{eventId}": {
      "get": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "One on-sale, with the server clock",
        "operationId": "event",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EventView"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{eventId}/availability": {
      "get": {
        "tags": [
          "Buying tickets"
        ],
        "summary": "Available-to-promise per section",
        "description": "Never blocks on writers. May be up to 1 s old; asOf says how old.",
        "operationId": "availability",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Availability"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/inventory/{inventoryId}/events": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "One section's event stream, oldest first",
        "operationId": "stream",
        "parameters": [
          {
            "name": "inventoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100,
              "maximum": 1000,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageStreamEvent"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/admin/events/{eventId}/position": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Inventory position as of an instant",
        "description": "Rebuilt from the event stream alone: every event with occurred_at <= at.",
        "operationId": "position",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "at",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Position"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/admin/events/{eventId}/analytics": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Oversell-attempt, conversion and expiry rates",
        "description": "Built by the Kafka consumer, so it trails the sale by the outbox interval.",
        "operationId": "analytics",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Analytics"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/admin/dead-letters": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Messages a consumer gave up on, oldest first",
        "operationId": "deadLetters",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 500,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageDeadLetter"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    },
    "/api/admin/attempts/quarantine": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Quarantined attempt lines with their original payload, oldest first",
        "operationId": "quarantine",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 500,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageQuarantined"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EventSpec": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "onSaleAt": {
            "type": "string",
            "format": "date-time"
          },
          "holdSeconds": {
            "type": "integer",
            "format": "int32",
            "maximum": 3600,
            "minimum": 5
          },
          "maxPerUser": {
            "type": "integer",
            "format": "int32",
            "maximum": 10,
            "minimum": 1
          },
          "admissionRatePerSec": {
            "type": "integer",
            "format": "int32",
            "maximum": 10000,
            "minimum": 1
          },
          "inventory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InventorySpec"
            },
            "maxItems": 500,
            "minItems": 0
          }
        },
        "required": [
          "admissionRatePerSec",
          "holdSeconds",
          "inventory",
          "maxPerUser",
          "name",
          "onSaleAt"
        ]
      },
      "InventorySpec": {
        "type": "object",
        "properties": {
          "ticketType": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Z0-9_]{1,32}"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Z0-9_]{1,32}"
          },
          "priceCents": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "maximum": 1000000,
            "minimum": 1
          }
        },
        "required": [
          "priceCents",
          "section",
          "ticketType",
          "total"
        ]
      },
      "EventView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "onSaleAt": {
            "type": "string",
            "format": "date-time"
          },
          "holdSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "maxPerUser": {
            "type": "integer",
            "format": "int32"
          },
          "admissionRatePerSec": {
            "type": "integer",
            "format": "int32"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReserveRequest": {
        "type": "object",
        "properties": {
          "inventoryId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "maximum": 10,
            "minimum": 1
          }
        },
        "required": [
          "inventoryId",
          "quantity"
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "inventoryId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "HELD",
              "CONFIRMED",
              "EXPIRED",
              "RELEASED"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Hard deadline. After this instant the hold cannot be confirmed, whether or not the sweeper has run yet."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time",
            "description": "Server clock at response time, so clients can count down without trusting their own clock."
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "LOBBY",
              "QUEUED",
              "ADMITTED",
              "NOT_IN_QUEUE"
            ]
          },
          "position": {
            "type": "integer",
            "format": "int32",
            "description": "1-based place in line. Only present when QUEUED: before the sale opens there is no order yet."
          },
          "estimatedWaitSeconds": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until admission at the current admission rate. A floor, not a promise: present when QUEUED or LOBBY (time until the sale opens)."
          },
          "admissionToken": {
            "type": "string",

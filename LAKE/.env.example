# Every setting the system reads. There are no secrets: the only external dependency is a
# public, unauthenticated download. Copy to .env and edit.

# Where raw inputs, variants and local measurements live. Keep it OFF synced folders
# (OneDrive, Dropbox): a sync client touching files mid-benchmark corrupts the timings.
LAKE_DATA_DIR=./data

# tlc = download NYC TLC yellow-taxi months; synthetic = generate taxi-shaped data offline.
LAKE_SOURCE=synthetic
# Months to fetch (tlc) or to spread synthetic pickups over. Comma separated YYYY-MM.
LAKE_MONTHS=2024-01,2024-02,2024-03
LAKE_TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
# Rows generated when LAKE_SOURCE=synthetic, and the seed for every generator.
LAKE_SYNTH_ROWS=300000
LAKE_SEED=8
# Rows per column in the column-type compression lab.
LAKE_LAB_ROWS=1000000

# Benchmark methodology. A cell is one (variant, query) pair.
LAKE_COLD_RUNS=3
LAKE_WARMUPS=1
LAKE_WARM_RUNS=5
# Once a cell has spent this many seconds on a kind of run it stops repeating, but never
# below 1 cold and 2 warm runs. Keeps a 30 s Avro query from costing 4 minutes per cell.
LAKE_CELL_BUDGET_S=20
# DuckDB / Arrow threads. 0 = all cores.
LAKE_THREADS=0

# Committed, published results the API serves when no local run exists.
LAKE_PUBLISHED_DIR=./results
LAKE_PORT=8000
LAKE_LOG_LEVEL=INFO

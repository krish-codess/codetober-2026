# Every setting the system reads. Copy to .env and replace each CHANGE_ME.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- secrets (required; compose refuses to start without them) ----
# Signs the personal links. Rotating it invalidates every link already sent.
WRAPPED_TOKEN_SECRET=CHANGE_ME
# Bearer token for /v1/admin/* and the analytics page (#admin).
WRAPPED_ADMIN_TOKEN=CHANGE_ME
# Three database users, least privilege each: owner runs migrations, batch writes payloads,
# api reads payloads and records views and shares.
WRAPPED_OWNER_DB_PASSWORD=CHANGE_ME
WRAPPED_BATCH_DB_PASSWORD=CHANGE_ME
WRAPPED_API_DB_PASSWORD=CHANGE_ME

# ---- behaviour ----
# "dev" permits the built-in development secrets; anything else refuses to start with them.
WRAPPED_ENV=production
# The calendar year (UTC) being wrapped.
WRAPPED_YEAR=2025
# Origin users reach the system on. Used in share links and link-preview tags.
WRAPPED_PUBLIC_BASE_URL=http://localhost:8080
# Host port for the UI.
WRAPPED_PORT=8080
# A comparison is only published if at least this many users clear the threshold behind it.
WRAPPED_K_ANONYMITY=10
# Users in the synthetic year generated on first start (20000 users is about 0.6M events).
WRAPPED_SEED_USERS=20000

# ---- resources ----
# DuckDB memory ceiling and threads for ingest, dbt and payload generation. It spills to disk past this.
WRAPPED_DUCKDB_MEMORY=1GB
WRAPPED_DUCKDB_THREADS=4
WRAPPED_LOG_LEVEL=INFO

# ---- running without Docker (see README) ----
# Where raw files, Parquet, the warehouse and rendered cards live. Keep it off synced folders.
# WRAPPED_DATA_DIR=./data
# WRAPPED_DATABASE_URL=postgresql://wrapped_api:...@127.0.0.1:5432/wrapped
# WRAPPED_BATCH_DATABASE_URL=postgresql://wrapped_batch:...@127.0.0.1:5432/wrapped
# WRAPPED_MIGRATE_DATABASE_URL=postgresql://wrapped_owner:...@127.0.0.1:5432/wrapped

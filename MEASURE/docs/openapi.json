            "type": "integer",
            "title": "Users"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          }
        },
        "type": "object",
        "required": [
          "users",
          "basis"
        ],
        "title": "Population"
      },
      "PublicShare": {
        "properties": {
          "share_id": {
            "type": "string",
            "title": "Share Id"
          },
          "login": {
            "type": "string",
            "title": "Login"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "card": {
            "$ref": "#/components/schemas/Card"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "share_id",
          "login",
          "year",
          "card",
          "image_url"
        ],
        "title": "PublicShare"
      },
      "ShareRateRow": {
        "properties": {
          "card_type": {
            "type": "string",
            "title": "Card Type"
          },
          "viewers": {
            "type": "integer",
            "title": "Viewers"
          },
          "sharers": {
            "type": "integer",
            "title": "Sharers"
          },
          "share_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Share Rate",
            "description": "sharers / viewers; null when nobody has viewed the card yet."
          }
        },
        "type": "object",
        "required": [
          "card_type",
          "viewers",

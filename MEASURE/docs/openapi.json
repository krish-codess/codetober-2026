  "components": {
    "schemas": {
      "Card": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "family": {
            "type": "string",
            "title": "Family"
          },
          "shareable": {
            "type": "boolean",
            "title": "Shareable"
          },
          "headline": {
            "type": "string",
            "title": "Headline"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "claim": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Claim"
              },
              {
                "type": "null"
              }
            ]
          },
          "stats": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Stat"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stats"
          }
        },
        "type": "object",
        "required": [
          "type",
          "family",
          "shareable",
          "headline",
          "value",
          "unit",
          "body"
        ],
        "title": "Card"
      },
      "Claim": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "top_permille": {
            "type": "integer",
            "title": "Top Permille",
            "description": "The claim in tenths of a percent: 50 means 'top 5%'."
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "basis": {
            "type": "string",
            "title": "Basis",
            "description": "Who the user is being compared with, in words."
          }
        },
        "type": "object",
        "required": [
          "metric",
          "top_permille",
          "text",
          "basis"
        ],
        "title": "Claim"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "PayloadPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PayloadSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Pass as `cursor` for the next page; null on the last page."
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "PayloadPage"
      },
      "PayloadSummary": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "login": {
            "type": "string",
            "title": "Login"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          }
        },
        "type": "object",
        "required": [

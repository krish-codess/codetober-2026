# Copy to .env. Every value here is a placeholder for local use; change them all anywhere else.
# Passwords and tokens go into connection URLs and headers: stick to letters, digits, - and _.

# PostgreSQL superuser. Used once, by `shipd init`, to create the two roles below and pgroll's state.
POSTGRES_PASSWORD=local-postgres-password
# ship_migrator: owns the schema, runs migrations, may read lock statistics. No superuser.
MIGRATOR_PASSWORD=local-migrator-password
# shop_app: the application. DML on the application tables, read on the compatibility matrix. No DDL.
APP_PASSWORD=local-app-password

# API tokens (Authorization: Bearer ...). The operator token can change things; the viewer token can only read.
SHIPD_OPERATOR_TOKEN=local-operator-token
SHIPD_VIEWER_TOKEN=local-viewer-token

# Orders the seed job generates and loads on first start. 1000000 is the size every number in docs/PERFORMANCE.md uses.
SEED_ORDERS=1000000
# Load from each application version: WORKERS connections, each doing about RATE operations per second.
WORKERS=8
RATE=25

# Host ports (all bound to 127.0.0.1).
DB_PORT=5544
SHIPD_PORT=8088
WEB_PORT=8089
PROMETHEUS_PORT=9099
GRAFANA_PORT=3099
GRAFANA_ADMIN_PASSWORD=local-grafana-password

LOG_LEVEL=info

# Copy to .env. This system has no secrets: the data is public, the API is read-only and has no
# users. Everything below is configuration.

# --- pipeline ---
# auto: download GloVe-Twitter 50-d (199 MB of a 1.5 GB archive), fall back to the generator if
#       the source is unreachable. The page labels synthetic data as synthetic.
# synth: always generate. glove-twitter-50: always download, fail if it cannot.
DOTS_SOURCE=synth
# Rows the generator writes (ignored for the real source).
DOTS_SYNTH_ROWS=200000
# One seed for the generator, landmark sample, k-means, UMAP and tile priority.
DOTS_SEED=15
# Rows UMAP is fitted on; the rest are placed with transform. Memory and time grow with this.
DOTS_LANDMARKS=100000
# Projection variants: pca, and umap-n<neighbours>-d<min_dist>.
DOTS_VARIANTS=pca,umap-n15-d0.1,umap-n50-d0.5
# Points per tile. Smaller = faster first view and finer level of detail, more requests.
DOTS_TILE_CAPACITY=32768
# Rows sampled for the evaluation.
DOTS_EVAL_QUERIES=4000
# Comma-separated mirrors of glove.twitter.27B.zip, tried in order. Must support range requests.
# DOTS_GLOVE_URLS=

# --- storage ---
# Raw inputs, intermediates and the published site. Keep it outside synced folders.
# Default: %LOCALAPPDATA%\render-dots on Windows, ~/.cache/render-dots elsewhere.
# DOTS_DATA_DIR=
# The published site (data/manifest.json and data/<build_id>/). Default: $DOTS_DATA_DIR/site
# DOTS_SITE_DIR=
# The built page the API serves at /. Default: web/dist
# DOTS_WEB_DIR=

# --- API ---
DOTS_HOST=127.0.0.1
DOTS_PORT=8015
# Origins allowed to call the API from a browser, comma-separated. Empty = same origin only.
DOTS_CORS_ORIGINS=
DOTS_LOG_LEVEL=INFO

# --- docker compose ---
DOTS_PUBLISHED_PORT=8015

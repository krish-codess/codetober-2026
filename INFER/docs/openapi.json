  "info": {
    "description": "HTTP API: model comparison, segments, scores, online prediction, and budgeted policies.\n\nContract, for every endpoint:\n  * `Authorization: Bearer <token>`. The read token may read; only the admin token may create or export a policy.\n  * Errors are always `{\"error\": {\"code\", \"message\", \"request_id\", \"details\"?}}` - never a stack trace.\n  * Every response carries `X-Request-ID` (yours if you sent one), and the same id is on every log line.\n  * Lists are cursor-paginated with a stable sort. POST /v1/policies is idempotent on `Idempotency-Key`.\n",
    "title": "Who actually needed the discount",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "operations"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness: exercises the database and the artifact store",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/datasets": {
      "get": {
        "operationId": "datasets_v1_datasets_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DatasetOut"
                  },
                  "title": "Response Datasets V1 Datasets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Datasets, what was quarantined, and what is being served",
        "tags": [
          "results"
        ]
      }
    },
    "/v1/datasets/{name}/experiment": {
      "get": {
        "operationId": "experiment_v1_datasets__name__experiment_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The served experiment: every learner's metrics and curves on identical data",
        "tags": [
          "results"
        ]
      }
    },
    "/v1/experiments/{experiment_id}/segments": {
      "get": {
        "operationId": "segment_scan_v1_experiments__experiment_id__segments_get",
        "parameters": [
          {
            "in": "path",
            "name": "experiment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Experiment Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "verdict",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "helps",
                    "hurts",
                    "unclear"
                  ],
                  "type": "string"
                },

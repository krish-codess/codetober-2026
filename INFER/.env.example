# Every setting the system reads. Copy to .env and replace each CHANGE_ME.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- secrets (required; compose refuses to start without them) ----
# Bearer token that can read results (the dashboard's sign-in).
UPLIFT_READ_TOKEN=CHANGE_ME
# Bearer token that can also create and export policies. Must differ from the read token.
UPLIFT_ADMIN_TOKEN=CHANGE_ME
# Three database users, least privilege each: owner runs migrations, batch loads data and results,
# api reads everything and writes only the policies it creates.
UPLIFT_OWNER_DB_PASSWORD=CHANGE_ME
UPLIFT_BATCH_DB_PASSWORD=CHANGE_ME
UPLIFT_API_DB_PASSWORD=CHANGE_ME

# ---- behaviour ----
# "dev" permits the built-in development tokens; anything else refuses to start with them.
UPLIFT_ENV=production
# Host port for the dashboard.
UPLIFT_PORT=8080
# Units in the synthetic experiment generated on first start (see docs/evidence/timings.md for how long that takes).
UPLIFT_SEED_UNITS=200000
# Recorded with every experiment so a model can be traced to the code that trained it.
UPLIFT_CODE_VERSION=unknown
# Tag of the images compose builds and runs; set it to a commit to keep an image to roll back to.
UPLIFT_IMAGE_TAG=local
UPLIFT_LOG_LEVEL=INFO

# ---- running without Docker (see README) ----
# Where raw files and model artifacts live. Keep it off synced folders.
# UPLIFT_DATA_DIR=./data
# UPLIFT_DATABASE_URL=postgresql://uplift_api:...@127.0.0.1:5432/uplift
# UPLIFT_BATCH_DATABASE_URL=postgresql://uplift_batch:...@127.0.0.1:5432/uplift
# UPLIFT_MIGRATE_DATABASE_URL=postgresql://uplift_owner:...@127.0.0.1:5432/uplift
# Where the real dataset is downloaded from. Left unset, the published file is used and checked against a pinned SHA-256.
# UPLIFT_HILLSTROM_URL=

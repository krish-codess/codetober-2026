      "type": "string"
     },
     "run_id": {
      "title": "Run Id",
      "type": "string"
     },
     "size_bytes": {
      "title": "Size Bytes",
      "type": "integer"
     },
     "target": {
      "title": "Target",
      "type": "string"
     },
     "variants": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "title": "Variants",
      "type": "array"
     }
    },
    "required": [
     "package_id",
     "name",
     "target",
     "run_id",
     "filename",
     "size_bytes",
     "git_commit",
     "dataset_version",
     "hosted",
     "variants"
    ],
    "title": "Package",
    "type": "object"
   },
   "Point": {
    "properties": {
     "arch": {
      "title": "Arch",
      "type": "string"
     },
     "bench": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/BenchSummary"
       },
       {
        "type": "null"
       }
      ],
      "description": "null: not measured on this target and runtime yet"
     },
     "gate": {
      "enum": [
       "pass",
       "fail"
      ],
      "title": "Gate",
      "type": "string"
     },
     "gate_reason": {
      "title": "Gate Reason",
      "type": "string"
     },
     "meets_budget": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "description": "p95 within the target's latency budget; null if unknown",
      "title": "Meets Budget"
     },
     "n_eval": {
      "title": "N Eval",
      "type": "integer"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "params": {
      "title": "Params",
      "type": "integer"
     },
     "parent": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent"
     },
     "parent_agree": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent Agree"
     },
     "parent_delta": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent Delta"
     },
     "parent_delta_hi": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent Delta Hi"
     },
     "parent_delta_lo": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent Delta Lo"
     },
     "pareto": {
      "description": "no other measured, gate-passing variant is both faster and more accurate",
      "title": "Pareto",
      "type": "boolean"
     },
     "precision": {
      "title": "Precision",
      "type": "string"
     },
     "size_bytes": {
      "title": "Size Bytes",
      "type": "integer"
     },
     "technique": {
      "title": "Technique",
      "type": "string"
     },
     "top1": {
      "title": "Top1",
      "type": "number"
     },
     "top1_deploy": {
      "title": "Top1 Deploy",
      "type": "number"
     },
     "top1_hi": {
      "title": "Top1 Hi",
      "type": "number"
     },
     "top1_lo": {
      "title": "Top1 Lo",
      "type": "number"
     }
    },
    "required": [
     "name",
     "parent",
     "technique",
     "arch",
     "precision",
     "params",
     "size_bytes",
     "top1",
     "top1_lo",
     "top1_hi",
     "n_eval",
     "top1_deploy",
     "parent_agree",
     "parent_delta",
     "parent_delta_lo",
     "parent_delta_hi",
     "gate",
     "gate_reason",
     "bench",
     "pareto",
     "meets_budget"
    ],
    "title": "Point",
    "type": "object"
   },
   "Power": {
    "description": "Watts from a real sensor. `unit: mW` is accepted and converted; nothing else is guessed.",
    "properties": {
     "energy_mj": {
      "description": "millijoules per inference, net of idle",
      "minimum": 0,
      "title": "Energy Mj",
      "type": "number"
     },
     "idle_w": {
      "maximum": 2000,
      "minimum": 0,
      "title": "Idle W",
      "type": "number"
     },
     "load_w": {
      "exclusiveMinimum": 0,
      "maximum": 2000,
      "title": "Load W",
      "type": "number"
     },
     "samples": {
      "minimum": 1,
      "title": "Samples",
      "type": "integer"
     },
     "source": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source",
      "type": "string"
     },
     "unit": {
      "default": "W",
      "enum": [
       "W",
       "mW"
      ],
      "title": "Unit",
      "type": "string"
     }
    },
    "required": [
     "source",
     "idle_w",
     "load_w",
     "energy_mj",
     "samples"
    ],
    "title": "Power",
    "type": "object"
   },

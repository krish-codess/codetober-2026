 "info": {
  "description": "squeeze API: the measured accuracy / latency / power tradeoff of every compressed model on\nevery hardware target, the deployment packages, and the endpoint devices upload results to.\n\nReads are public. Uploading needs the device token; the quarantine needs the admin token.\nEvery error has the same shape: `{\"error\": {\"code\", \"message\", \"details\"}, \"request_id\"}`.\n",
  "title": "squeeze",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",

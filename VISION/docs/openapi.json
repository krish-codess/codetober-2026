{
 "components": {
  "schemas": {
   "Accuracy": {
    "properties": {
     "agree_host": {
      "description": "share of predictions equal to the build host's",
      "maximum": 1,
      "minimum": 0,
      "title": "Agree Host",
      "type": "number"
     },
     "n": {
      "description": "evaluation images run on the device",
      "exclusiveMinimum": 0,
      "title": "N",
      "type": "integer"
     },
     "top1": {
      "maximum": 1,
      "minimum": 0,
      "title": "Top1",
      "type": "number"
     }
    },
    "required": [
     "n",
     "top1",
     "agree_host"
    ],
    "title": "Accuracy",
    "type": "object"
   },
   "BenchResult": {
    "description": "One model benchmarked on one device, as written by device/edge_bench.py.",
    "properties": {
     "accuracy": {
      "$ref": "#/components/schemas/Accuracy"
     },
     "device": {
      "$ref": "#/components/schemas/Device"
     },
     "latency_ms": {
      "$ref": "#/components/schemas/Latency"
     },
     "measured_at": {
      "description": "ISO 8601 or Unix seconds; a naive time is taken as UTC",
      "format": "date-time",
      "title": "Measured At",
      "type": "string"
     },
     "model_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Sha256",
      "type": "string"
     },
     "power": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Power"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "power_unavailable": {
      "anyOf": [
       {
        "maxLength": 300,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Power Unavailable"
     },
     "provider": {
      "default": "",
      "maxLength": 60,
      "title": "Provider",
      "type": "string"
     },
     "result_id": {
      "description": "idempotency key: hash of the result",
      "pattern": "^[0-9a-f]{16,64}$",
      "title": "Result Id",
      "type": "string"
     },
     "run_id": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Run Id"
     },
     "runtime": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
      "title": "Runtime",
      "type": "string"
     },
     "runtime_version": {
      "default": "",
      "maxLength": 60,
      "title": "Runtime Version",
      "type": "string"
     },
     "schema": {
      "const": 1,
      "title": "Schema",
      "type": "integer"
     },
     "synthetic": {
      "default": false,
      "description": "true for generated load-test data",
      "title": "Synthetic",
      "type": "boolean"
     },
     "target": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
      "title": "Target",
      "type": "string"
     },
     "threads": {
      "maximum": 4096,
      "minimum": 0,
      "title": "Threads",
      "type": "integer"
     },
     "variant": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
      "title": "Variant",
      "type": "string"
     }
    },
    "required": [
     "schema",
     "result_id",
     "target",
     "variant",
     "model_sha256",
     "runtime",
     "threads",
     "measured_at",
     "device",
     "latency_ms",
     "accuracy"
    ],
    "title": "BenchResult",
    "type": "object"
   },
   "BenchSummary": {
    "properties": {
     "agree_host": {
      "title": "Agree Host",
      "type": "number"
     },
     "cpu_model": {
      "title": "Cpu Model",
      "type": "string"
     },
     "energy_mj": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Energy Mj"
     },
     "idle_w": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Idle W"
     },
     "last_measured_at": {
      "title": "Last Measured At",
      "type": "string"
     },
     "load_w": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Load W"
     },
     "p50_ms": {
      "title": "P50 Ms",
      "type": "number"
     },
     "p95_ms": {
      "title": "P95 Ms",
      "type": "number"
     },
     "p99_ms": {
      "title": "P99 Ms",
      "type": "number"
     },
     "power_source": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Power Source"
     },
     "power_unavailable": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Power Unavailable"
     },
     "runs": {
      "title": "Runs",
      "type": "integer"
     },
     "threads": {
      "title": "Threads",
      "type": "integer"
     },
     "top1_device": {
      "title": "Top1 Device",
      "type": "number"
     }
    },
    "required": [
     "runs",
     "p50_ms",
     "p95_ms",
     "p99_ms",
     "top1_device",
     "agree_host",
     "load_w",
     "idle_w",
     "energy_mj",
     "power_source",
     "power_unavailable",
     "cpu_model",
     "threads",
     "last_measured_at"
    ],
    "title": "BenchSummary",
    "type": "object"
   },
   "Device": {
    "properties": {
     "board": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Board"
     },
     "cores": {
      "maximum": 4096,
      "minimum": 1,
      "title": "Cores",
      "type": "integer"
     },
     "cpu_model": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Cpu Model",
      "type": "string"
     },
     "machine": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Machine",
      "type": "string"
     },
     "os": {
      "maxLength": 200,
      "title": "Os",
      "type": "string"
     }
    },
    "required": [
     "machine",
     "cpu_model",
     "cores",
     "os"
    ],
    "title": "Device",
    "type": "object"
   },
   "Error": {
    "properties": {
     "error": {
      "$ref": "#/components/schemas/ErrorBody"
     },
     "request_id": {
      "title": "Request Id",
      "type": "string"
     }
    },
    "required": [
     "error",
     "request_id"
    ],
    "title": "Error",
    "type": "object"
   },
   "ErrorBody": {
    "properties": {
     "code": {
      "title": "Code",
      "type": "string"
     },
     "details": {
      "default": [],
      "items": {},
      "title": "Details",
      "type": "array"
     },
     "message": {
      "title": "Message",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "title": "ErrorBody",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "Latency": {
    "properties": {
     "mean": {
      "exclusiveMaximum": 600000,
      "exclusiveMinimum": 0,
      "title": "Mean",
      "type": "number"
     },
     "n": {
      "description": "timed single-image inferences",
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "title": "N",
      "type": "integer"
     },
     "p50": {
      "description": "milliseconds",
      "exclusiveMaximum": 600000,
      "exclusiveMinimum": 0,
      "title": "P50",
      "type": "number"
     },
     "p95": {
      "exclusiveMaximum": 600000,
      "exclusiveMinimum": 0,
      "title": "P95",
      "type": "number"
     },
     "p99": {
      "exclusiveMaximum": 600000,
      "exclusiveMinimum": 0,
      "title": "P99",
      "type": "number"
     }
    },
    "required": [
     "n",
     "p50",
     "p95",
     "p99",
     "mean"
    ],
    "title": "Latency",
    "type": "object"
   },
   "Package": {
    "properties": {
     "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
     },
     "filename": {
      "title": "Filename",
      "type": "string"
     },
     "git_commit": {
      "title": "Git Commit",
      "type": "string"
     },
     "hosted": {
      "description": "false: this server knows the package but does not hold the file",
      "title": "Hosted",
      "type": "boolean"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "package_id": {
      "description": "sha256 of the archive",

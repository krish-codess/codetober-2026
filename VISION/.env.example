# Copy to .env. Nothing here is a real secret; replace every CHANGE_ME.

# Token a device presents to upload benchmark results (POST /v1/results). Least privilege: it can
# only append results.
SQUEEZE_DEVICE_TOKEN=CHANGE_ME
# Token for operators: read the quarantine. Never ship this to a device.
SQUEEZE_ADMIN_TOKEN=CHANGE_ME

# SQLite file. It is derived: `python -m squeeze ingest results/raw` rebuilds it.
SQUEEZE_DB=./squeeze.db
# Directory the API serves deployment packages from.
SQUEEZE_PACKAGES_DIR=./release
# Raw result files (immutable). Uploaded results are appended here as well as to the database.
SQUEEZE_RAW_DIR=./results/raw
# Where the dataset, model checkpoints and pipeline runs live. Keep it outside synced folders.
# Default: %LOCALAPPDATA%\vision-squeeze on Windows, ~/.cache/vision-squeeze elsewhere.
# SQUEEZE_DATA_DIR=

# Largest accepted request body in bytes.
SQUEEZE_MAX_BODY=262144
SQUEEZE_LOG_LEVEL=INFO
# Port published by docker compose.
SQUEEZE_PORT=8080

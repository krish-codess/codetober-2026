# Copy to .env. Every value here is a local-development default; change all secrets before deploying.

# --- PostgreSQL -------------------------------------------------------------
# Owner role: runs migrations only. Never given to the API or worker.
POSTGRES_USER=parse_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=parse
# Application role: DML only, no DDL, cannot UPDATE/DELETE raw_feedback. Created by migration 0001.
APP_DB_USER=parse_app
APP_DB_PASSWORD=change-me-app

# Host ports (container-internal ports are fixed)
DB_PORT=5441
API_PORT=8041
WEB_PORT=8141

# --- Auth -------------------------------------------------------------------
# Bearer tokens seeded into api_tokens (stored as SHA-256). Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token
ANNOTATOR_TOKEN=change-me-annotator-token
VIEWER_TOKEN=change-me-viewer-token

# --- Embeddings ---------------------------------------------------------------
# onnx = multilingual-e5-small (int8) via ONNX Runtime; hash = offline char n-gram hashing (tests/CI only)
EMBED_BACKEND=onnx

# --- Seeding ------------------------------------------------------------------
# real = download M-ABSA (pinned revision) from Hugging Face; synthetic = offline generator.
# If the real download fails after retries the seed falls back to synthetic and says so in the log.
SEED_SOURCE=real
# Languages evaluated on the parallel test set (comma separated). Fewer languages = faster first boot.
SEED_TEST_LANGS=en,es,de,fr,ja,zh,ru,ar,tr,hi,th,sw
# Labels the simulated annotator provides at seed time so the first model exists.
SEED_LABELS=300

# --- Retraining ---------------------------------------------------------------
RETRAIN_INTERVAL_S=900
RETRAIN_MIN_NEW_LABELS=25
# Candidate is rejected if hierarchical micro-F1 on the test split drops by more than this vs the active model.
GATE_MAX_DROP=0.02

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

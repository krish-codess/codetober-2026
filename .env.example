# Copy to .env and change every password. Nothing in this file is a real secret.

# --- PostgreSQL ------------------------------------------------------------------
# Superuser: used ONLY by the postgres container's first-boot init script.
POSTGRES_PASSWORD=change-me-superuser
# Schema owner: runs migrations. Never used by long-running processes.
GS_OWNER_PASSWORD=change-me-owner
# Pipeline (Dagster): INSERT into published tables, SELECT reference data.
GS_PIPELINE_PASSWORD=change-me-pipeline
# API: SELECT on published tables, INSERT on patch_event/idempotency_key only.
GS_API_PASSWORD=change-me-api

# Host port of the compose postgres (5433 avoids clashing with a locally installed PostgreSQL).
GS_PG_PORT=5433
GS_DATABASE_URL=postgresql://gs_pipeline:change-me-pipeline@localhost:5433/goldstandard
GS_API_DATABASE_URL=postgresql://gs_api:change-me-api@localhost:5433/goldstandard
GS_OWNER_DATABASE_URL=postgresql://gs_owner:change-me-owner@localhost:5433/goldstandard

# --- Pipeline --------------------------------------------------------------------
GS_DATA_DIR=./data
GS_ESI_BASE_URL=https://esi.evetech.net/latest
GS_ESI_USER_AGENT=goldstandard-cpi/0.1 (contact: you@example.com)
GS_HTTP_MAX_RETRIES=5
GS_HTTP_BACKOFF_BASE_S=0.5
GS_HTTP_BACKOFF_CAP_S=30
GS_ESI_CONCURRENCY=8
# Synthetic world size. Days are counted back from today.
GS_SYNTH_SERVERS=4
GS_SYNTH_DAYS=395
GS_SYNTH_SEED=20251001

# --- API ---------------------------------------------------------------------------
GS_LOG_LEVEL=INFO
GS_LOG_JSON=true
GS_STALE_AFTER_HOURS=48
GS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Bootstrap admin key for POST /v1/patches (stored hashed; printed nowhere).
GS_BOOTSTRAP_ADMIN_KEY=change-me-admin-key

# --- Frontend build ----------------------------------------------------------------
VITE_API_BASE=http://localhost:8000

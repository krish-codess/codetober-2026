# Copy to .env. Every value here is a LOCAL DEVELOPMENT placeholder - generate real ones for any shared environment.
# Nothing in the codebase has a default for the secrets below: the app refuses to start without them.

# --- PostgreSQL -------------------------------------------------------------
# Owner role: runs Flyway migrations only (DDL). Never used to serve requests.
DB_OWNER_USER=lastticket_owner
DB_OWNER_PASSWORD=change-me-owner
# App role: DML only; INSERT/SELECT only on the append-only tables (created by migration V1).
DB_APP_USER=lastticket_app
DB_APP_PASSWORD=change-me-app
DB_NAME=lastticket
DB_URL=jdbc:postgresql://postgres:5432/lastticket
DB_POOL_SIZE=20

# --- Redis (waiting room + availability cache; safe to lose) ----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- Kafka (downstream propagation) -----------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Auth -------------------------------------------------------------------
# HMAC-SHA256 key for session + admission tokens. At least 32 bytes. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me-32b
# Static key for /api/admin/** (X-Admin-Key header). `openssl rand -hex 32`
ADMIN_API_KEY=change-me-admin

# --- Behaviour --------------------------------------------------------------
# Seed a demo on-sale (1200 tickets, on sale SEED_ON_SALE_IN_SECONDS after first boot) when the DB has no events.
SEED_DEMO=true
SEED_ON_SALE_IN_SECONDS=60
# How long an admitted user has to start a reservation before going back to the queue.
ADMISSION_TTL_SECONDS=600
SWEEPER_INTERVAL_MS=1000
OUTBOX_INTERVAL_MS=200

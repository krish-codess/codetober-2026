# Copy to .env. Nothing here is a real secret; change every value outside local dev.

# PostgreSQL owner: runs migrations only.
POSTGRES_USER=tydlc_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=tydlc

# Least-privilege role used by the API and the runner (SELECT/INSERT/UPDATE + TEMP).
TYDLC_APP_PASSWORD=change-me-app

# Required to start runs over HTTP (POST /api/runs, X-API-Key header).
TYDLC_API_KEY=change-me-api-key

# Host ports. Deliberately not 8000/5432, which are usually taken on a dev machine.
API_PORT=8028
POSTGRES_PORT=5438

# Optional tuning.
LOG_LEVEL=INFO
# Shrink processes per run; 0 = one per CPU.
TYDLC_WORKERS=0

# For running the CLI/tests on the host against the compose database:
# DATABASE_URL=postgresql://tydlc_app:change-me-app@localhost:5438/tydlc
# MIGRATION_DATABASE_URL=postgresql://tydlc_owner:change-me-owner@localhost:5438/tydlc

# Copy to .env. Nothing here is a real secret; change every password before deploying.

# --- PostgreSQL / PostGIS -------------------------------------------------------------------
# Owner: runs migrations only. The services never use it.
POSTGRES_PASSWORD=change-me-owner
# One login per service, least privilege (see ghostfleet/migrations/002_roles.up.sql).
GHOST_INGEST_PASSWORD=change-me-ingest
GHOST_DETECT_PASSWORD=change-me-detect
GHOST_API_PASSWORD=change-me-api

# --- Providers ------------------------------------------------------------------------------
# Comma-separated name=url. tcp:// is a raw NMEA relay, wss:// is AISStream.
#   sim        the bundled simulator (always available)
#   kystverket the Norwegian Coastal Administration's open feed (no key; not reachable from every network)
#   aisstream  global feed, needs AISSTREAM_API_KEY (free at https://aisstream.io)
# Listing the simulator twice is deliberate: two providers that overlap completely prove deduplication.
GHOST_SOURCES=sim_a=tcp://sim:5631,sim_b=tcp://sim:5631
# GHOST_SOURCES=kystverket=tcp://153.44.253.27:5631,aisstream=wss://stream.aisstream.io/v0/stream
AISSTREAM_API_KEY=

# --- Simulator ------------------------------------------------------------------------------
SIM_SHIPS=3000
SEED_HOURS=6

# --- Tuning (defaults shown; see docs/decisions.md for why) -----------------------------------
# GHOST_PARTITIONS=12            Kafka partitions of ais.positions (key: MMSI)
# GHOST_RETENTION_H=72           Kafka retention of ais.positions
# GHOST_RECONNECT_BASE_S=1       provider reconnect: full-jitter exponential backoff, base...
# GHOST_RECONNECT_CAP_S=60       ...and cap
# GHOST_IDLE_TIMEOUT_S=30        a provider silent this long is treated as dead and reconnected
# GHOST_FRAGMENT_TIMEOUT_S=5     incomplete multi-part sentences are quarantined after this
# GHOST_GAP_MOVING_S=1800        silence of a moving vessel that counts as a gap
# GHOST_GAP_STATIONARY_S=21600   same, for a vessel that was not moving
# GHOST_MAX_SPEED_KN=50          a reappearance needing more than this is impossible
# GHOST_COVERAGE_MIN=0.8         reception (0-1) a cell needs before silence there is the vessel's fault
# GHOST_COVERAGE_CELL_DEG=0.25   coverage grid cell size
# GHOST_NEIGHBOUR_RADIUS_M=20000 how near another vessel must be heard to prove the receiver was up
# GHOST_LOOKBACK_H=72            detector window; also the longest gap it can see
# GHOST_DETECT_INTERVAL_S=60
# GHOST_LOG_LEVEL=INFO

# --- Frontend -------------------------------------------------------------------------------
# Origins allowed to call the API from a browser, when the UI is hosted elsewhere (a CDN).
GHOST_CORS_ORIGINS=
# Ports published on the host.
API_PORT=8000
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me-grafana

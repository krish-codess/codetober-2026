  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/coverage": {
      "get": {
        "description": "The empirical reception grid the detector reasons with.",
        "operationId": "coverage_api_v1_coverage_get",
        "parameters": [
          {
            "description": "minLon,minLat,maxLon,maxLat in degrees",
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "minLon,minLat,maxLon,maxLat in degrees",
              "examples": [
                "4,58,12,62"
              ],
              "title": "Bbox"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20000,
              "maximum": 50000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coverage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Coverage",
        "tags": [
          "context"
        ]
      }
    },
    "/api/v1/dark-events": {
      "get": {
        "description": "Silences ranked by suspiciousness, highest first. Ties break on id, so paging never skips or repeats.",
        "operationId": "dark_events_api_v1_dark_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "classification",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "dark",
                    "coverage_gap",
                    "position_jump"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Classification"
            }
          },
          {
            "in": "query",
            "name": "min_score",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 100,
              "minimum": 0,
              "title": "Min Score",
              "type": "number"
            }
          },
          {
            "description": "Only reappearances that needed an impossible speed",
            "in": "query",
            "name": "impossible_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "Only reappearances that needed an impossible speed",
              "title": "Impossible Only",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "mmsi",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "description": "Maritime Mobile Service Identity of a ship station",
                  "maximum": 799999999,
                  "minimum": 200000000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mmsi"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "`next_cursor` from the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` from the previous page",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DarkEvents"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Dark Events",
        "tags": [
          "dark events"
        ]
      }
    },
